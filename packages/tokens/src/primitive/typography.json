{
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "Inter, ui-sans-serif, system-ui, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "'IBM Plex Mono', ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace"
      }
    },
    "size": {
      "75": { "$type": "dimension", "$value": "0.75rem" },
      "100": { "$type": "dimension", "$value": "0.875rem" },
      "200": { "$type": "dimension", "$value": "1rem" },
      "300": { "$type": "dimension", "$value": "1.25rem" },
      "400": { "$type": "dimension", "$value": "1.5rem" },
      "500": { "$type": "dimension", "$value": "2rem" },
      "600": { "$type": "dimension", "$value": "2.5rem" },
      "sm": { "$type": "dimension", "$value": "{font.size.100}" },
      "base": { "$type": "dimension", "$value": "{font.size.200}" },
      "lg": { "$type": "dimension", "$value": "{font.size.300}" },
      "xl": { "$type": "dimension", "$value": "{font.size.400}" }
    },
    "lineHeight": {
      "100": { "$type": "dimension", "$value": "1rem" },
      "200": { "$type": "dimension", "$value": "1.25rem" },
      "300": { "$type": "dimension", "$value": "1.5rem" },
      "400": { "$type": "dimension", "$value": "1.75rem" },
      "500": { "$type": "dimension", "$value": "2rem" },
      "600": { "$type": "dimension", "$value": "2.5rem" },
      "700": { "$type": "dimension", "$value": "3rem" }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": "400" },
      "medium": { "$type": "fontWeight", "$value": "500" },
      "semibold": { "$type": "fontWeight", "$value": "600" },
      "bold": { "$type": "fontWeight", "$value": "700" }
    },
    "letterSpacing": {
      "normal": { "$type": "dimension", "$value": "0em" },
      "wide": { "$type": "dimension", "$value": "0.01em" }
    }
  },
  "typography": {
    "body": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.200}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.300}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    },
    "bodySmall": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.100}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.200}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    },
    "label": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.100}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.200}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.medium}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    },
    "headingSm": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.300}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.400}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    },
    "headingMd": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.400}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.500}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    },
    "headingLg": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.500}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.600}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.semibold}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    },
    "code": {
      "fontSize": { "$type": "dimension", "$value": "{font.size.100}" },
      "lineHeight": { "$type": "dimension", "$value": "{font.lineHeight.200}" },
      "fontWeight": { "$type": "fontWeight", "$value": "{font.weight.regular}" },
      "letterSpacing": { "$type": "dimension", "$value": "{font.letterSpacing.normal}" }
    }
  }
}
