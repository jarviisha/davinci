{
  "shadow": {
    "none": {
      "$type": "shadow",
      "$value": "none"
    },
    "light": {
      "card": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(9, 30, 66, 0.12), 0 0 1px rgba(9, 30, 66, 0.16)"
      },
      "raised": {
        "$type": "shadow",
        "$value": "0 4px 8px rgba(9, 30, 66, 0.12), 0 0 1px rgba(9, 30, 66, 0.16)"
      },
      "overlay": {
        "$type": "shadow",
        "$value": "0 8px 16px rgba(9, 30, 66, 0.16), 0 0 1px rgba(9, 30, 66, 0.20)"
      }
    },
    "dark": {
      "card": {
        "$type": "shadow",
        "$value": "0 1px 2px rgba(1, 4, 4, 0.32), 0 0 1px rgba(227, 228, 242, 0.12)"
      },
      "raised": {
        "$type": "shadow",
        "$value": "0 6px 12px rgba(1, 4, 4, 0.36), 0 0 1px rgba(227, 228, 242, 0.16)"
      },
      "overlay": {
        "$type": "shadow",
        "$value": "0 12px 24px rgba(1, 4, 4, 0.44), 0 0 1px rgba(227, 228, 242, 0.20)"
      }
    }
  }
}
