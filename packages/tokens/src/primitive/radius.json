{
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "sm": { "$type": "dimension", "$value": "0.25rem" },
    "md": { "$type": "dimension", "$value": "0.375rem" },
    "lg": { "$type": "dimension", "$value": "0.5rem" },
    "xl": { "$type": "dimension", "$value": "0.75rem" },
    "full": { "$type": "dimension", "$value": "9999px" },
    "control": { "$type": "dimension", "$value": "{radius.md}" },
    "card": { "$type": "dimension", "$value": "{radius.lg}" },
    "panel": { "$type": "dimension", "$value": "{radius.xl}" },
    "pill": { "$type": "dimension", "$value": "{radius.full}" }
  }
}
