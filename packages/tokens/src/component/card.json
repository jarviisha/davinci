{
  "component": {
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.300}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.200}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{semantic.color.foreground}"
      },
      "default": {
        "background": { "$type": "color", "$value": "{semantic.color.background}" },
        "border": { "$type": "color", "$value": "{semantic.color.border}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.none}" }
      },
      "outlined": {
        "background": { "$type": "color", "$value": "transparent" },
        "borderSubtle": { "$type": "color", "$value": "{semantic.color.border}" },
        "border": { "$type": "color", "$value": "{semantic.color.borderBold}" },
        "borderBold": { "$type": "color", "$value": "{semantic.color.borderBoldest}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.none}" }
      },
      "filled": {
        "background": { "$type": "color", "$value": "{semantic.color.backgroundSubtle}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.none}" }
      },
      "floating": {
        "background": { "$type": "color", "$value": "{semantic.color.surfaceRaised}" },
        "border": { "$type": "color", "$value": "{semantic.color.border}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.raised}" }
      },
      "toneInfo": {
        "background": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.info} 8%, {semantic.color.background})" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.info} 30%, {semantic.color.border})" },
        "backgroundHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.info} 12%, {semantic.color.backgroundHovered})" },
        "borderHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.info} 38%, {semantic.color.borderHovered})" }
      },
      "toneSuccess": {
        "background": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.success} 8%, {semantic.color.background})" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.success} 30%, {semantic.color.border})" },
        "backgroundHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.success} 12%, {semantic.color.backgroundHovered})" },
        "borderHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.success} 38%, {semantic.color.borderHovered})" }
      },
      "toneWarning": {
        "background": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.warning} 8%, {semantic.color.background})" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.warning} 30%, {semantic.color.border})" },
        "backgroundHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.warning} 12%, {semantic.color.backgroundHovered})" },
        "borderHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.warning} 38%, {semantic.color.borderHovered})" }
      },
      "toneDanger": {
        "background": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.danger} 8%, {semantic.color.background})" },
        "border": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.danger} 30%, {semantic.color.border})" },
        "backgroundHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.danger} 12%, {semantic.color.backgroundHovered})" },
        "borderHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.danger} 38%, {semantic.color.borderHovered})" }
      },
      "selected": {
        "background": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.primary} 8%, {semantic.color.background})" },
        "border": { "$type": "color", "$value": "{semantic.color.borderFocused}" },
        "backgroundHovered": { "$type": "color", "$value": "color-mix(in srgb, {semantic.color.primary} 12%, {semantic.color.backgroundHovered})" }
      }
    }
  }
}
