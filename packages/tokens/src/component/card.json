{
  "component": {
    "card": {
      "radius": {
        "$type": "dimension",
        "$value": "{radius.card}"
      },
      "padding": {
        "$type": "dimension",
        "$value": "{spacing.300}"
      },
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.200}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{semantic.color.foreground}"
      },
      "elevated": {
        "background": { "$type": "color", "$value": "{semantic.color.surfaceRaised}" },
        "border": { "$type": "color", "$value": "{semantic.color.border}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.card}" }
      },
      "surface": {
        "background": { "$type": "color", "$value": "{semantic.color.surfaceRaised}" },
        "border": { "$type": "color", "$value": "{semantic.color.border}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.none}" }
      },
      "outlined": {
        "background": { "$type": "color", "$value": "transparent" },
        "borderSubtle": { "$type": "color", "$value": "{semantic.color.border}" },
        "border": { "$type": "color", "$value": "{semantic.color.borderBold}" },
        "borderBold": { "$type": "color", "$value": "{semantic.color.borderStrong}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.none}" }
      },
      "filled": {
        "background": { "$type": "color", "$value": "{semantic.color.surface}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.none}" }
      },
      "floating": {
        "background": { "$type": "color", "$value": "{semantic.color.surfaceRaised}" },
        "border": { "$type": "color", "$value": "{semantic.color.border}" },
        "shadow": { "$type": "shadow", "$value": "{semantic.shadow.raised}" }
      }
    }
  }
}
