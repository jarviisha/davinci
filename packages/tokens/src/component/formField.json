{
  "component": {
    "formField": {
      "gap": {
        "$type": "dimension",
        "$value": "{spacing.075}"
      },
      "label": {
        "foreground": { "$type": "color", "$value": "{semantic.color.foreground}" },
        "requiredForeground": { "$type": "color", "$value": "{semantic.color.dangerText}" }
      },
      "help": {
        "foreground": { "$type": "color", "$value": "{semantic.color.foregroundSubtle}" }
      },
      "error": {
        "foreground": { "$type": "color", "$value": "{semantic.color.dangerText}" }
      }
    }
  }
}
