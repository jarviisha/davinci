{
  "component": {
    "input": {
      "height": {
        "sm": { "$type": "dimension", "$value": "2rem" },
        "md": { "$type": "dimension", "$value": "2.5rem" },
        "lg": { "$type": "dimension", "$value": "3rem" }
      },
      "paddingX": {
        "$type": "dimension",
        "$value": "{spacing.150}"
      },
      "paddingY": {
        "$type": "dimension",
        "$value": "{spacing.100}"
      },
      "radius": {
        "$type": "dimension",
        "$value": "{semantic.radius.control}"
      },
      "background": {
        "$type": "color",
        "$value": "{semantic.color.background}"
      },
      "backgroundHovered": {
        "$type": "color",
        "$value": "{semantic.color.backgroundHovered}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border}"
      },
      "borderHovered": {
        "$type": "color",
        "$value": "{semantic.color.borderHovered}"
      },
      "borderFocused": {
        "$type": "color",
        "$value": "{semantic.color.borderFocused}"
      },
      "borderInvalid": {
        "$type": "color",
        "$value": "{semantic.color.dangerText}"
      },
      "foreground": {
        "$type": "color",
        "$value": "{semantic.color.foreground}"
      },
      "placeholder": {
        "$type": "color",
        "$value": "{semantic.color.foregroundSubtlest}"
      },
      "disabled": {
        "background": { "$type": "color", "$value": "{semantic.color.backgroundDisabled}" },
        "border": { "$type": "color", "$value": "{semantic.color.borderDisabled}" },
        "foreground": { "$type": "color", "$value": "{semantic.color.foregroundDisabled}" }
      }
    }
  }
}
