{
  "name": "@jarviisha/davinci-tailwind-preset",
  "version": "0.3.0",
  "description": "Tailwind CSS v4 preset that maps Davinci design tokens to utility classes.",
  "license": "MIT",
  "author": "jarviisha",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jarviisha/davinci.git",
    "directory": "packages/tailwind-preset"
  },
  "homepage": "https://github.com/jarviisha/davinci#readme",
  "bugs": "https://github.com/jarviisha/davinci/issues",
  "keywords": [
    "tailwindcss",
    "tailwind-preset",
    "design-system",
    "design-tokens",
    "davinci"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/theme.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/theme.css','dist/theme.css')\"",
    "prepack": "pnpm build",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
